{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Node - Backend Server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "nodemon",
      "program": "${workspaceFolder}/server.ts",
      "restart": true,
      "runtimeArgs": ["--require", "ts-node/register"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
